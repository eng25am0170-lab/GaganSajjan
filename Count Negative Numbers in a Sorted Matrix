class Solution {
    public int countNegatives(int[][] grid) {
        int m = grid.length, n = grid[0].length;
        int r = 0, c = n - 1, count = 0;
        while (r < m && c >= 0) {
            if (grid[r][c] < 0) {
                count += m - r;
                c--;
            } else {
                r++;
            }
        }
        return count;
    }
}
